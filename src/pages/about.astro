---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import AboutSocialIcons from "@/components/AboutSocialIcons.astro";
import { SITE } from "@/config";
---

<Layout title={`关于 | ${SITE.title}`}>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout">
    <section id="about" class="app-prose mb-28 max-w-app prose-img:border-0">
      <h1 class="text-2xl tracking-wider sm:text-3xl">关于</h1>

      <p>玉碎珠沉</p>

      <AboutSocialIcons />
    </section>
  </main>
  <Footer />
</Layout>
