---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import AffiliateCard from "@/components/AffiliateCard.astro";
import HomeSocialLinks from "@/components/HomeSocialLinks.astro";
import HomeCategoryTabs from "@/components/HomeCategoryTabs.astro";
import HomePostCard from "@/components/HomePostCard.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { AFFILIATES } from "@/data/affiliates";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const homeAffiliates = AFFILIATES.filter(item => item.featured).slice(0, 3);

const hasMatchingTag = (
  post: (typeof sortedPosts)[number],
  matchTags: string[]
) =>
  post.data.tags.some(tag =>
    matchTags.some(matchTag => tag.toLowerCase() === matchTag.toLowerCase())
  );


const groupMatchers = {
  tools: (post: (typeof sortedPosts)[number]) =>
    hasMatchingTag(post, [
      "API",
      "VPS",
      "Claude",
      "Google Play",
      "反向代理",
      "中转",
    ]),
  ai: (post: (typeof sortedPosts)[number]) =>
    hasMatchingTag(post, ["AI", "Claude", "Codex", "Agent", "Workflow"]),
  building: (post: (typeof sortedPosts)[number]) =>
    hasMatchingTag(post, ["API", "VPS", "反向代理", "中转", "日本", "评测"]),
  vps: (post: (typeof sortedPosts)[number]) => hasMatchingTag(post, ["VPS"]),
};

const homePosts = sortedPosts.map(post => ({
  post,
  groups: Object.entries(groupMatchers)
    .filter(([, matcher]) => matcher(post))
    .map(([group]) => group),
}));

const countGroup = (filter: string) =>
  filter === "all"
    ? homePosts.length
    : homePosts.filter(({ groups }) => groups.includes(filter)).length;

const categoryTabs = [
  { label: "全部", filter: "all", count: countGroup("all") },
  { label: "工具", filter: "tools", count: countGroup("tools") },
  { label: "AI", filter: "ai", count: countGroup("ai") },
  {
    label: "建站",
    filter: "building",
    count: countGroup("building"),
  },
  { label: "VPS", filter: "vps", count: countGroup("vps") },
];
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index">
    <section
      id="hero"
      class="relative overflow-hidden border-b border-border bg-background text-foreground dark:bg-[#080a0c] dark:text-white"
    >
      <div
        class="home-hero-inner mx-auto flex w-full max-w-[48rem] flex-col items-center px-4 pt-4 pb-7 text-center sm:px-6 sm:pt-5 sm:pb-8"
      >
        <img
          src="/images/dandelion-mark.webp"
          alt=""
          class="home-hero-image pointer-events-none h-36 w-full max-w-[30rem] object-contain opacity-45 invert dark:opacity-64 dark:invert-0"
          loading="eager"
        />

        <h1
          class="home-hero-title mt-0 text-2xl font-bold tracking-normal text-foreground dark:text-white"
        >
          你好，我是艾伦。
        </h1>
        <p
          class="mt-4 max-w-[42rem] text-base leading-8 text-foreground/64 dark:text-white/68"
        >
          长期实践 AI、自动化和轻量部署，记录普通人如何把 AI
          变成真正能长期协作的工作伙伴。
        </p>

        <HomeSocialLinks />

        {
          homeAffiliates.length > 0 && (
            <div class="home-promo-grid mt-7 grid w-full max-w-[48rem] gap-4 grid-cols-3">
              {homeAffiliates.map(item => (
                <AffiliateCard variant="promo" {...item} />
              ))}
            </div>
          )
        }

        <div
          class="home-hero-separator mt-7 text-2xl leading-none text-foreground/18 dark:text-white/22"
        >
          ~~
        </div>
      </div>
    </section>

    <HomeCategoryTabs tabs={categoryTabs} />

    <section
      id="home-posts"
      class="home-posts-section mx-auto w-full max-w-[77.5rem] px-4 py-8 sm:px-6 sm:py-9"
    >
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          homePosts.map(({ post, groups }) => (
            <div
              data-home-post
              data-home-groups={groups.join(" ")}
            >
              <HomePostCard {...post} />
            </div>
          ))
        }
      </div>

      <p
        class="hidden rounded-lg border border-border bg-background px-5 py-8 text-center text-sm text-foreground/55"
        data-home-empty
      >
        暂无文章
      </p>

      <div data-home-sentinel class="h-2"></div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
