---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import getCategoryGroups from "@/utils/getCategoryGroups";
import { SITE } from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("blog");
  const categoryGroups = getCategoryGroups(posts);

  return categoryGroups.flatMap(({ category, categoryName, posts }) =>
    paginate(posts, {
      params: { category },
      props: { categoryName },
      pageSize: SITE.postPerPage,
    })
  );
}

const { category } = Astro.params;
const { page, categoryName } = Astro.props;
---

<Layout title={`分类：${categoryName} | ${SITE.title}`}>
  <Header />
  <Main
    pageTitle={[`分类：`, `${categoryName}`]}
    titleTransition={category}
    pageDesc={`分类“${categoryName}”下的全部文章。`}
  >
    <ul>
      {page.data.map(data => <Card {...data} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
