---
import { SOCIALS } from "@/constants";
import LinkButton from "./LinkButton.astro";
---

<div class="flex flex-wrap items-center gap-2">
  {
    SOCIALS.map(social => (
      <LinkButton
        href={social.href}
        class="rounded-full border border-border px-3 py-1.5 text-sm hover:bg-card"
        title={social.linkTitle}
        target="_blank"
        rel="noopener noreferrer"
      >
        {social.icon && (
          <social.icon class="inline-block size-4 fill-transparent stroke-current stroke-2 opacity-90" />
        )}
        <span>{social.label ?? social.name}</span>
      </LinkButton>
    ))
  }
</div>
