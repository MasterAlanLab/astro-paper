---
import { AUTHOR_LINKS } from "@/constants";
import LinkButton from "./LinkButton.astro";
---

{
  AUTHOR_LINKS.some(social => social.icon && social.showInMinimalList) && (
    <div class="mt-6 flex items-center gap-3">
      <span class="text-muted-foreground text-sm">关注我：</span>
      <div class="flex items-center gap-3">
        {AUTHOR_LINKS.filter(
          social => social.icon && social.showInMinimalList
        ).map(social => (
          <LinkButton
            href={social.href}
            class="text-foreground/80 transition hover:text-accent"
            title={social.linkTitle}
            aria-label={social.linkTitle}
            target="_blank"
            rel="noopener noreferrer"
          >
            {social.icon && (
              <social.icon class="inline-block size-5 fill-transparent stroke-current stroke-2 opacity-90" />
            )}
            <span class="sr-only">{social.label ?? social.name}</span>
          </LinkButton>
        ))}
      </div>
    </div>
  )
}
