---
import type { HomePostSummary } from "@/utils/homePosts";

type Props = HomePostSummary;

const { path, title, description, pubDatetime, publishedDate } = Astro.props;
---

<article>
  <a
    href={path}
    class="group flex min-h-[11rem] flex-col rounded-lg border border-border bg-background p-5 transition hover:-translate-y-0.5 hover:border-foreground/35 hover:bg-muted/20"
  >
    <h3 class="line-clamp-2 text-base leading-7 font-semibold text-foreground">
      {title}
    </h3>

    <p class="mt-3 line-clamp-3 text-sm leading-6 text-foreground/60">
      {description}
    </p>

    <time
      class="mt-auto pt-5 text-xs font-medium text-foreground/42"
      datetime={pubDatetime}
    >
      发布于 {publishedDate}
    </time>
  </a>
</article>
