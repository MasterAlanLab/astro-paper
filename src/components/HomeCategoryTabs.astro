---
import HomePostCard from "./HomePostCard.astro";

type CategoryTab = {
  label: string;
  filter: string;
  count?: number;
  icon?: string;
  active?: boolean;
};

type Props = {
  tabs: CategoryTab[];
  batchSize?: number;
};

const { tabs, batchSize = 8 } = Astro.props;
---

<section
  class="border-b border-border bg-background/95"
  id="home-categories"
  data-home-batch-size={batchSize}
>
  <nav
    class="home-category-nav mx-auto flex max-w-[77.5rem] gap-2 overflow-x-auto px-4 py-4 sm:justify-center sm:gap-3 sm:px-6"
    aria-label="首页分类"
  >
    {
      tabs.map(tab => (
        <button
          type="button"
          data-home-filter={tab.filter}
          data-home-count={tab.count}
          aria-pressed={tab.active ? "true" : "false"}
          class:list={[
            "home-category-tab",
            { "home-category-tab-active": tab.active },
          ]}
        >
          {tab.icon && <span>{tab.icon}</span>}
          <span>{tab.label}</span>
          {typeof tab.count === "number" && (
            <span class="home-category-count">{tab.count}</span>
          )}
        </button>
      ))
    }
  </nav>

  <template data-home-post-template>
    <div>
      <HomePostCard
        path=""
        title=""
        description=""
        pubDatetime=""
        publishedDate=""
        categories={[]}
      />
    </div>
  </template>
</section>

<script>
  import type { HomePostSummary } from "@/utils/homePosts";

  let homePostsObserver: IntersectionObserver | null = null;
  let homePostsRequest: Promise<HomePostSummary[]> | null = null;
  let homePostsData: HomePostSummary[] | null = null;

  const setupHomeCategoryTabs = () => {
    homePostsObserver?.disconnect();
    homePostsObserver = null;

    const root = document.querySelector<HTMLElement>("#home-categories");
    const postsRoot = document.querySelector<HTMLElement>("#home-posts");
    const template = document.querySelector<HTMLTemplateElement>(
      "[data-home-post-template]"
    );
    if (!root || !postsRoot || !template) return;

    const createHomePost = (post: HomePostSummary) => {
      const container = template.content.firstElementChild!.cloneNode(
        true
      ) as HTMLElement;
      container.dataset.homePost = "";
      container.dataset.homeCategories = post.categories.join(" ");
      container.dataset.homePath = post.path;

      const link = container.querySelector("a")!;
      link.href = post.path;
      container.querySelector("h3")!.textContent = post.title;
      container.querySelector("p")!.textContent = post.description;

      const publishedTime = container.querySelector("time")!;
      publishedTime.dateTime = post.pubDatetime;
      publishedTime.textContent = `发布于 ${post.publishedDate}`;

      return container;
    };

    const tabs = root.querySelectorAll<HTMLButtonElement>("[data-home-filter]");
    const postsGrid = postsRoot.querySelector<HTMLElement>(
      "[data-home-posts-grid]"
    );
    const emptyState =
      postsRoot.querySelector<HTMLElement>("[data-home-empty]");
    const sentinel = postsRoot.querySelector<HTMLElement>(
      "[data-home-sentinel]"
    );
    const postsBatchSize = Math.max(
      1,
      Number.parseInt(root.dataset.homeBatchSize ?? "8", 10) || 8
    );

    if (!tabs.length || !postsGrid) return;

    let currentFilter =
      Array.from(tabs).find(tab => tab.getAttribute("aria-pressed") === "true")
        ?.dataset.homeFilter ?? "all";
    let visibleCount = postsBatchSize;
    const visibleCounts = new Map<string, number>([
      [currentFilter, visibleCount],
    ]);
    let updateInProgress = false;

    const getPostCategories = (post: HTMLElement) =>
      post.dataset.homeCategories?.split(" ") ?? [];

    const matchesFilter = (post: HTMLElement, filter: string) => {
      const categories = getPostCategories(post);
      return filter === "all" || categories.includes(filter);
    };

    const getFilterTotal = () => {
      const activeTab = Array.from(tabs).find(
        tab => tab.dataset.homeFilter === currentFilter
      );
      return Number(activeTab?.dataset.homeCount ?? 0);
    };

    const loadAllPosts = () => {
      if (homePostsRequest) return homePostsRequest;

      const postsURL = postsRoot.dataset.homePostsUrl;
      if (!postsURL) return Promise.resolve([]);

      homePostsRequest = fetch(postsURL)
        .then(response => {
          if (!response.ok) throw new Error("Failed to load home posts");
          return response.json() as Promise<HomePostSummary[]>;
        })
        .then(posts => {
          homePostsData = posts;
          return posts;
        })
        .catch(() => []);

      return homePostsRequest;
    };

    const updatePostVisibility = async (loadMissingPosts = false) => {
      let posts = Array.from(
        postsGrid.querySelectorAll<HTMLElement>("[data-home-post]")
      );
      const matchingPosts = posts.filter(post =>
        matchesFilter(post, currentFilter)
      );
      const filterTotal = getFilterTotal();

      if (
        filterTotal > matchingPosts.length &&
        (loadMissingPosts || visibleCount > matchingPosts.length)
      ) {
        await loadAllPosts();
      }

      let visiblePosts: Set<HTMLElement>;

      if (homePostsData) {
        const desiredPosts = homePostsData
          .filter(
            post =>
              currentFilter === "all" || post.categories.includes(currentFilter)
          )
          .slice(0, visibleCount);
        const postsByPath = new Map(
          posts.map(post => [post.dataset.homePath, post] as const)
        );
        const desiredElements = desiredPosts.map(post => {
          const existingPost = postsByPath.get(post.path);
          if (existingPost) return existingPost;

          const newPost = createHomePost(post);
          postsByPath.set(post.path, newPost);
          return newPost;
        });

        for (const post of desiredElements) postsGrid.appendChild(post);

        posts = Array.from(
          postsGrid.querySelectorAll<HTMLElement>("[data-home-post]")
        );
        visiblePosts = new Set(desiredElements);
      } else {
        visiblePosts = new Set(matchingPosts.slice(0, visibleCount));
      }

      posts.forEach(post => {
        const visible = visiblePosts.has(post);
        post.hidden = !visible;
        post.classList.toggle("hidden", !visible);
      });

      emptyState?.classList.toggle("hidden", visiblePosts.size > 0);
    };

    const selectFilter = async (filter: string) => {
      visibleCounts.set(currentFilter, visibleCount);
      currentFilter = filter;
      visibleCount = visibleCounts.get(filter) ?? postsBatchSize;
      tabs.forEach(tab => {
        const active = tab.dataset.homeFilter === filter;
        tab.setAttribute("aria-pressed", String(active));
        tab.classList.toggle("home-category-tab-active", active);
      });
      await updatePostVisibility(filter !== "all");
      setupObserver();
    };

    const loadMorePosts = async () => {
      if (updateInProgress || visibleCount >= getFilterTotal()) return;

      updateInProgress = true;
      try {
        visibleCount += postsBatchSize;
        visibleCounts.set(currentFilter, visibleCount);
        await updatePostVisibility(true);
      } finally {
        updateInProgress = false;
      }
    };

    const setupObserver = () => {
      homePostsObserver?.disconnect();
      homePostsObserver = null;
      if (!sentinel) return;
      homePostsObserver = new IntersectionObserver(
        entries => {
          if (entries.some(entry => entry.isIntersecting)) {
            void loadMorePosts();
          }
        },
        { rootMargin: "200px" }
      );
      homePostsObserver.observe(sentinel);
    };

    tabs.forEach(tab => {
      if (tab.dataset.filterReady === "true") return;
      tab.dataset.filterReady = "true";
      tab.addEventListener("click", () => {
        void selectFilter(tab.dataset.homeFilter ?? "all");
      });
    });

    void selectFilter(currentFilter);
  };

  setupHomeCategoryTabs();

  document.addEventListener("astro:after-swap", () => {
    setupHomeCategoryTabs();
  });
</script>
